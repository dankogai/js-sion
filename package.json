{
  "name": "js-sion",
  "version": "1.3.1",
  "description": "SION deserializer/serializer for ECMAScript",
  "main": "sion.js",
  "module": "sion.js",
  "type": "module",
  "types": "sion.d.ts",
  "sideEffects": false,
  "files": [
    "sion.d.ts",
    "sion.js"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p . --declaration --emitDeclarationOnly && node util/sync-test-html.cjs",
    "clean": "node -e \"['sion.js','sion.d.ts'].forEach(f=>require('fs').rmSync(f,{force:true}))\"",
    "test": "npm run build && mocha",
    "version": "npm run build && node util/sync-version.cjs && git add sion.js sion.d.ts test/index.html test/console-local.html README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dankogai/js-sion.git"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^20.9.0",
    "chai": "^4.2.0",
    "mocha": "^10.0.0",
    "rollup": "^4.62.3",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "SION",
    "JSON",
    "Serialization"
  ],
  "author": "Dan Kogai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dankogai/js-sion/issues"
  },
  "homepage": "https://github.com/dankogai/js-sion#readme"
}
